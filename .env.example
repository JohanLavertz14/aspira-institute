# PostgreSQL connection string
# บนเครื่องพัฒนา ใช้ connection string ของ Neon ได้เลย (คนละฐานข้อมูลกับ production)
# บน Vercel ค่านี้จะถูกตั้งอัตโนมัติเมื่อเชื่อมฐานข้อมูล Neon เข้ากับโปรเจกต์
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# คีย์สำหรับเซ็น JWT ของระบบล็อกอิน ต้องสุ่มใหม่และไม่ใช้ซ้ำระหว่างเครื่องพัฒนากับ production
# สุ่มด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="ข้อความสุ่มยาวอย่างน้อย 32 ตัวอักษร"

# URL ของเว็บ
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ที่เก็บไฟล์อัปโหลด (สลิป ชีท โลโก้)
# บน Vercel ค่านี้จะถูกตั้งอัตโนมัติเมื่อสร้าง Blob store
# ถ้าไม่ใส่ ระบบจะเก็บไฟล์ลงโฟลเดอร์ public/uploads ในเครื่องแทน
# BLOB_READ_WRITE_TOKEN=""
