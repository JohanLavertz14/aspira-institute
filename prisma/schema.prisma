// Prisma schema สำหรับเว็บไซต์คอร์สเรียนออนไลน์ Aspira Institute
// ใช้ PostgreSQL ทั้งบนเครื่องพัฒนาและบน production (Neon ผ่าน Vercel)
// connection string อ่านจาก DATABASE_URL ใน .env และใน Environment Variables ของ Vercel

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// สถานะต่าง ๆ เก็บเป็น String เพื่อให้เพิ่มค่าใหม่ได้โดยไม่ต้อง migrate
// role:            STUDENT | ADMIN
// order.status:    PENDING | WAITING_REVIEW | PAID | REJECTED | CANCELLED
// payment.status:  PENDING | APPROVED | REJECTED
// video.provider:  VIMEO | YOUTUBE | FILE

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  school       String?
  gradeLevel   String? // เช่น ม.4 ม.5 ม.6
  role         String   @default("STUDENT")
  isActive     Boolean  @default(true)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollments Enrollment[]
  orders      Order[]
  progress    LessonProgress[]
  attempts    QuizAttempt[]
  comments    Comment[]
  reviewed    Payment[]        @relation("PaymentReviewer")
}

model Subject {
  id          String   @id @default(cuid())
  name        String // เช่น คณิตศาสตร์
  slug        String   @unique
  description String?
  colorHex    String   @default("#f43f74")
  iconKey     String   @default("book") // ใช้เลือกไอคอนในหน้าเว็บ
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  courses Course[]
}

model Course {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  subtitle     String?
  description  String   @default("")
  subjectId    String
  level        String   @default("ม.ปลาย") // ม.ต้น | ม.ปลาย | อื่นๆ
  price        Int      @default(0) // หน่วยเป็นบาท
  comparePrice Int? // ราคาก่อนลด ไว้แสดงขีดฆ่า
  accessDays   Int      @default(180) // จำนวนวันที่เรียนได้หลังอนุมัติ
  coverImage   String? // เว้นว่างได้ ระบบจะใช้ภาพ placeholder
  // เอกสารประกอบคอร์สทั้งเล่ม ให้นักเรียนดาวน์โหลดก่อนเริ่มเรียน
  materialTitle String?
  materialUrl   String?
  teacherName  String   @default("")
  teacherBio   String?
  totalHours   Float    @default(0)
  isPublished  Boolean  @default(false)
  isFeatured   Boolean  @default(false)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapters    Chapter[]
  enrollments Enrollment[]
  orders      Order[]

  @@index([subjectId])
}

model Chapter {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  summary   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
}

model Lesson {
  id            String   @id @default(cuid())
  chapterId     String
  title         String
  description   String?
  videoProvider String   @default("VIMEO")
  videoId       String   @default("") // เช่น 76979871 ของ Vimeo
  videoUrl      String? // ใช้กรณีเป็นไฟล์หรือลิงก์เต็ม
  durationMin   Int      @default(0)
  isPreview     Boolean  @default(false) // ดูฟรีได้โดยไม่ต้องซื้อ
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  chapter     Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  attachments Attachment[]
  quiz        Quiz?
  progress    LessonProgress[]
  comments    Comment[]

  @@index([chapterId])
}

model Attachment {
  id        String   @id @default(cuid())
  lessonId  String
  title     String
  fileUrl   String
  fileType  String   @default("PDF")
  sizeLabel String? // เช่น 1.2 MB
  createdAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model Quiz {
  id          String   @id @default(cuid())
  lessonId    String   @unique
  title       String
  description String?
  passScore   Int      @default(60) // เปอร์เซ็นต์ที่ถือว่าผ่าน
  createdAt   DateTime @default(now())

  lesson    Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuizAttempt[]
}

model Question {
  id          String   @id @default(cuid())
  quizId      String
  text        String
  explanation String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  choices Choice[]

  @@index([quizId])
}

model Choice {
  id         String @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false)
  order      Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model QuizAttempt {
  id            String   @id @default(cuid())
  quizId        String
  userId        String
  score         Int      @default(0)
  total         Int      @default(0)
  passed        Boolean  @default(false)
  answersJson   String   @default("{}") // เก็บคำตอบที่เลือกไว้ดูย้อนหลัง
  createdAt     DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([quizId, userId])
}

model Enrollment {
  id        String    @id @default(cuid())
  userId    String
  courseId  String
  orderId   String?
  startsAt  DateTime  @default(now())
  expiresAt DateTime
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

model LessonProgress {
  id             String   @id @default(cuid())
  userId         String
  lessonId       String
  completed      Boolean  @default(false)
  secondsWatched Int      @default(0)
  lastViewedAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
}

model Order {
  id        String   @id @default(cuid())
  code      String   @unique // เลขที่คำสั่งซื้อ เช่น ASP-250909-0001
  userId    String
  courseId  String
  amount    Int
  status    String   @default("PENDING")
  method    String   @default("BANK_TRANSFER") // BANK_TRANSFER | PROMPTPAY | CARD
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId])
  @@index([status])
}

model Payment {
  id           String    @id @default(cuid())
  orderId      String
  amount       Int
  slipUrl      String? // ไฟล์สลิปที่นักเรียนอัปโหลด
  paidAt       DateTime
  payerNote    String?
  status       String    @default("PENDING")
  rejectReason String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("PaymentReviewer", fields: [reviewedById], references: [id])

  @@index([orderId])
  @@index([status])
}

model Comment {
  id        String   @id @default(cuid())
  lessonId  String
  userId    String
  parentId  String?
  body      String
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())

  lesson  Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([lessonId])
}

// ข้อมูลสถาบันและช่องทางชำระเงิน แก้ไขได้จากหลังบ้าน
model SiteSetting {
  id             String   @id @default("singleton")
  siteName       String   @default("Aspira Institute")
  tagline        String   @default("")
  logoUrl        String? // เว้นว่างไว้ก่อน แล้วค่อยอัปโหลดโลโก้จริง
  aboutText      String   @default("")
  contactPhone   String   @default("")
  contactEmail   String   @default("")
  contactLine    String   @default("")
  contactAddress String   @default("")
  facebookUrl    String   @default("")
  bankName       String   @default("")
  bankBranch     String   @default("")
  bankAccountNo  String   @default("")
  bankAccountName String  @default("")
  promptpayId    String   @default("")
  promptpayQrUrl String? // รูป QR พร้อมเพย์
  cardEnabled    Boolean  @default(false) // เปิดเมื่อพร้อมต่อระบบบัตร
  updatedAt      DateTime @updatedAt @default(now())
}
